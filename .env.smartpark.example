# 智慧园区前端环境示例。复制为 .env.development.local 后由 Vite 加载，勿提交副本。
# 端口表：后端 18080 / 前端 dev 18180；禁用 8080/8081/9680
# 前端请求前缀仍用 /dev-api，由开发服务器转发到下面的园区后端。

VITE_APP_TITLE = 智慧园区
VITE_APP_LOGO_TITLE = 智慧园区

VITE_APP_BASE_API = '/dev-api'
VITE_APP_PORT = 18180

# 园区后端 API 基址
VITE_APP_BASE_URL = 'http://127.0.0.1:18080'
